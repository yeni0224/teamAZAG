{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/check_dangerous_command.py",
            "timeout": 30,
            "statusMessage": "Checking shell command safety"
          }
        ]
      }
    ]
  }
}
