{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Harness Step Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "commands", "details"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "error", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "notes"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "details": {
      "type": "string"
    }
  }
}
